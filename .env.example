# Conduit — example environment file
# Copy to prod.env or test.env and fill in your values.

RUST_LOG=conduitd=info
CONDUIT_PLAIN_ENABLED=1
CONDUIT_PLAIN_ADDR=0.0.0.0:1883
CONDUIT_TLS_ADDR=0.0.0.0:8883
CONDUIT_API_ADDR=0.0.0.0:9090
CONDUIT_API_ADMIN_TOKEN=change-me
CONDUIT_INFLUX_URL=https://your-influxdb:8086
CONDUIT_INFLUX_ORG=YourOrg
CONDUIT_INFLUX_BUCKET=your-bucket
CONDUIT_INFLUX_TOKEN=change-me
CONDUIT_REGISTRY_URL=https://your-backend/api/devices/authorized
CONDUIT_REGISTRY_RELOAD_SECS=300
CONDUIT_REGISTRY_API_KEY=change-me
CONDUIT_AUTH_SALT=change-me

# Docker
IMAGE=conduitd:latest
MQTT_PORT=1883
MQTT_PROXY_PORT=8884
API_PORT=9091
TLS_PORT=8883