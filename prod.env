# Conduit — production environment
# Source with:  set -a && . prod.env && set +a  (or docker compose reads these directly)

RUST_LOG=conduitd=info
CONDUIT_PLAIN_ENABLED=1
CONDUIT_PLAIN_ADDR=0.0.0.0:1883
CONDUIT_TLS_ADDR=0.0.0.0:8883
CONDUIT_API_ADDR=0.0.0.0:9090
CONDUIT_API_ADMIN_TOKEN=REDACTED_API_TOKEN
CONDUIT_INFLUX_URL=https://REDACTED_IP:8086
CONDUIT_INFLUX_ORG=OpenWatt
CONDUIT_INFLUX_BUCKET=openwatt
CONDUIT_INFLUX_TOKEN=REDACTED_INFLUX_TOKEN
CONDUIT_REGISTRY_URL=https://REDACTED_HOST/api/devices/authorized
CONDUIT_REGISTRY_RELOAD_SECS=300
CONDUIT_REGISTRY_API_KEY=REDACTED_API_TOKEN
CONDUIT_AUTH_SALT=REDACTED_AUTH_SALT

# Docker
IMAGE=ghcr.io/openwatt-energy/conduit:latest
MQTT_PORT=1883
MQTT_PROXY_PORT=8884
API_PORT=9091
TLS_PORT=8883