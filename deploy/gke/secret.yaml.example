apiVersion: v1
kind: Secret
metadata:
  name: conduit-secrets
  labels:
    app: conduit
type: Opaque
stringData:
  CONDUIT_AUTH_SALT: "${CONDUIT_AUTH_SALT}"
  CONDUIT_INFLUX_TOKEN: "${CONDUIT_INFLUX_TOKEN}"
  CONDUIT_API_ADMIN_TOKEN: "${CONDUIT_API_ADMIN_TOKEN}"
  CONDUIT_REGISTRY_API_KEY: "${CONDUIT_REGISTRY_API_KEY}"